rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
// These rules replace the "test mode" defaults that were implicitly required by
// the previous client-side writer. The browser is NOT a trusted writer: the app
// authenticates with Clerk, so Firestore receives no Firebase Auth token, and
// every direct client write will now be denied. To sync user profiles, mint
// Firebase Auth custom tokens (matching the Clerk user id) from a trusted
// backend that verifies the Clerk session first, then sign in on the client.
service cloud.firestore {
  match /databases/{database}/documents {

    function selfOnly(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents: owner-only, document id must carry the same uid
    match /users/{userId} {
      allow get, list: if selfOnly(userId);
      allow create: if selfOnly(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;
      allow update: if selfOnly(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;

      // Login history: append-only for the owner, no rewrites of past entries
      match /auth_history/{historyId} {
        allow get, list: if selfOnly(userId);
        allow create: if selfOnly(userId);
        allow update, delete: if false;
      }
    }
  }
}
